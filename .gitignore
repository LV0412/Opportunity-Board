# Only publish the main project files to GitHub
*
!README.md
!.gitignore
!docs/
!docs/**
!backend/
!backend/**
!frontend/
!frontend/**
!.agents/
!.agents/skills/
!.agents/skills/**
!.codex/
!.codex/**

# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/build/
**/target/

# Environment files
**/.env
**/.env.*
!backend/.env.example
!frontend/.env.example

# IDE and OS
**/.idea/
**/.vscode/
**/*.iml
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
